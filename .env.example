# Copy to .env and adjust. Never commit the real .env.
PORT=8080
# Where the SQLite database lives (use a persistent volume in production)
DATABASE_PATH=./data/terram.db
# Secret used to sign CSRF/session material. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
# Optional: enables Claude-assisted interpretation of messy messages.
# Without it, the deterministic rules interpreter still handles most orders.
ANTHROPIC_API_KEY=
# Optional: WhatsApp Business Cloud API webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: inbound email webhook shared token
EMAIL_INBOUND_TOKEN=
# Initial admin (used only when the database has no users)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional: email every online order (Settings → Customer form lists who gets it).
# Use your business mailbox's SMTP details. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on the email (defaults to SMTP_USER)
SMTP_FROM=
